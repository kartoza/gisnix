# Kanata keyboard remapping — the layer/mod/nav mechanism GISNIX ships,
# generated by ./kanata-config.nix. See docs/user/keyboard.md for the key
# reference; this file is just the systemd/uinput wiring.
#
# Add your user to the uinput group in your host config:
#   users.groups.uinput.members = [ "your-username" ];
{
  config,
  pkgs,
  lib,
  hostConfig,
  ...
}:
let
  # Timing (milliseconds). tapTimeout/holdTimeout govern the space/menu
  # hold into the navigation layer; modTapTimeout/modHoldTimeout govern the
  # home-row mods. Raise either hold value if taps are misfiring as holds
  # on your hardware; lower it if the modifiers feel sluggish to arm.
  tapTimeout = 280;
  holdTimeout = 280;

  # Which xkb layout this host's keyboards type under. A host knob
  # (`kanataLayout` in hosts/<name>/config.nix) rather than a hardcoded
  # value, because it changes which physical key `@` and `-` live under —
  # see kanata-config.nix's own `layout` parameter for why.
  layout = hostConfig.kanataLayout or "us";

  # Bracket chords ship on by default — layout and chord file are two
  # statements of one fact (the chord outputs are keycodes for that
  # layout), so they are selected together here. An unlisted layout fails
  # evaluation rather than pairing a guessed chord file with it. Bigram/word
  # expansion chords do NOT ship by default (no `expansionsFile` below) —
  # those fire mid-word on ordinary typing and are opt-in for exactly that
  # reason; a host wanting them supplies its own file.
  chordsFile =
    {
      us = ./chords-us.kbd;
      pt = ./chords-pt.kbd;
    }
    .${layout};

  # Set by kanata-email.nix from whichever users have declared their own
  # `kartoza.userEmails.<name>` — null until at least one has.
  emailScript = config.kartoza.kanataEmailScript;

  # obsLayer's scene-switch bindings need the same brand prefix
  # obs-setup.py namespaced the scenes with ("Kartoza Webcam", "QGIS
  # Webcam") — this is the SAME hostConfig.bootTheme ternary
  # obs-scenes.nix uses for the same reason; if you change one, change the
  # other, or a host's keyboard starts switching to scenes that don't
  # exist in its own OBS.
  obsScenePrefix = if (hostConfig.bootTheme or "kartoza") == "qgis" then "QGIS" else "Kartoza";

  # kanata's own systemd unit is a SYSTEM service (it needs /dev/uinput and
  # /dev/input, which is also why it carries the uinput/openrazer
  # supplementary groups below) — not something the user's session manager
  # spawned. Systemd only sets XDG_RUNTIME_DIR for units IT launches inside
  # a user's own manager; a bare `pw-play` invoked from this service's
  # `cmd` actions (the herdr<->aerc mode-toggle beep, herdr's macro-record
  # click) has no PipeWire socket to reach and fails silently — the `cmd`
  # "succeeds" from kanata's point of view
  # (pw-play exits nonzero, kanata just logs it), so nothing looked broken
  # short of actually listening for the sound. This wrapper hunts down
  # whichever logged-in user's PipeWire socket is actually up and plays
  # into that one, rather than hardcoding a uid that would break the
  # moment a different user logs in or the uid changes.
  kanataPlaySound = pkgs.writeShellScriptBin "kanata-play-sound" ''
    for sock in /run/user/*/pipewire-0; do
      if [ -S "$sock" ]; then
        export XDG_RUNTIME_DIR="''${sock%/pipewire-0}"
        exec ${pkgs.pipewire}/bin/pw-play "$@"
      fi
    done
    # No PipeWire session up — nothing to play into. Exit 0 regardless:
    # a `cmd` action failing is not a reason to disrupt the key press it
    # rode in on.
    exit 0
  '';

  # j/k on the obs layer — steps the program scene forward/backward
  # through gisnix's OWN 8-scene order (obs-setup.py's SCENE_BASE_NAMES:
  # Intro, Webcam, Screen, ScreenCam, ScreenOverlay, Terminal, Outro,
  # BRB — keep this bash array and that Python list in lockstep, not
  # whatever order obs-websocket's GetSceneList happens to report — that
  # depends on OBS's own scene-insertion behaviour, which this has no
  # business depending on. Pure network I/O (obs-websocket over
  # localhost), so — unlike kanataLayerIndicator's Wayland/GTK problem —
  # kanata's locked-down DynamicUser service has everything it needs to
  # run this directly, no session access required.
  obsSceneStep = pkgs.writeShellApplication {
    name = "obs-scene-step";
    runtimeInputs = [ pkgs.obs-cli ];
    text = ''
      direction="$1"
      order=(Intro Webcam Screen ScreenCam ScreenOverlay Terminal Outro BRB)

      current="$(obs-cli scene get --port 4455)"
      prefix="''${current% *}"
      base="''${current##* }"

      index=-1
      for i in "''${!order[@]}"; do
        if [ "''${order[$i]}" = "$base" ]; then
          index=$i
          break
        fi
      done
      # Current scene isn't one of ours (OBS's own default "Scene", say)
      # — nothing sensible to step from, so do nothing rather than guess.
      if [ "$index" -eq -1 ]; then
        exit 0
      fi

      count=''${#order[@]}
      if [ "$direction" = next ]; then
        next_index=$(( (index + 1) % count ))
      else
        next_index=$(( (index - 1 + count) % count ))
      fi

      obs-cli scene current --port 4455 "$prefix ''${order[$next_index]}"
    '';
  };

  kanataLayerIndicatorPython = pkgs.python3.withPackages (ps: [
    ps.pystray
    ps.pillow
    ps.pygobject3
  ]);

  # pystray's only Wayland-compatible backend (StatusNotifierItem, via
  # libayatana-appindicator over GObject-Introspection — the plain Gtk
  # backend is X11-tray-protocol only) needs each dependency's OWN
  # typelib findable on GI_TYPELIB_PATH — unlike shared libraries, that
  # search path is NOT resolved transitively through gtk3's own RPATH, so
  # every package in Gtk-3.0.typelib's real dependency chain needs its
  # own entry here, confirmed against gtk3's actual linked closure
  # (`patchelf --print-rpath libgtk-3.so.0`) rather than guessed:
  # glib (GLib/GObject/Gio/GModule), gdk-pixbuf, at-spi2-core (Atk),
  # harfbuzz and pango all ship their own .typelib next to gtk3's.
  # gobject-introspection itself has to be in the mix too — it bundles a
  # handful of "bonus" typelibs (xlib-2.0, cairo-1.0, fontconfig-2.0,
  # freetype2-2.0) for C libraries that carry no GIR annotations of their
  # own, which Gdk-3.0.typelib still declares a dependency on.
  #
  # First attempt here only listed gtk3 + libayatana-appindicator, which
  # got further (past the "Namespace Gtk not available" ValueError that
  # crashed the service outright) but pystray's own ImportError handling
  # swallowed the real cause and silently fell back to its X11 backend,
  # which can never work under COSMIC's Wayland-only session — confirmed
  # by importing `gi.repository.Gtk`/`AyatanaAppIndicator3` directly
  # (bypassing pystray's except-and-continue) against the real store
  # paths this host already has built.
  kanataLayerIndicatorGiDeps = [
    pkgs.gtk3
    pkgs.glib
    pkgs.gdk-pixbuf
    pkgs.at-spi2-core
    pkgs.harfbuzz
    pkgs.pango
    pkgs.libayatana-appindicator
    pkgs.gobject-introspection
  ];
  # makeLibraryPath (below) has its own output-selection smarts and
  # correctly picks each package's "lib" output — makeSearchPath has
  # none, and for glib/pango specifically their BARE (default) output is
  # "bin", which has no lib/girepository-1.0 at all (confirmed empirically:
  # the typelibs live only under each package's "out" output). Force "out"
  # explicitly for every dependency rather than relying on whatever a
  # bare package reference happens to default to.
  kanataLayerIndicatorGiPath = pkgs.lib.makeSearchPath "lib/girepository-1.0" (
    map (pkgs.lib.getOutput "out") kanataLayerIndicatorGiDeps
  );
  kanataLayerIndicatorLibPath = pkgs.lib.makeLibraryPath kanataLayerIndicatorGiDeps;

  kanataLayerIndicator = pkgs.writeShellApplication {
    name = "kanata-layer-indicator";
    runtimeInputs = [ kanataLayerIndicatorPython ];
    text = ''
      export LATO_DIR="${pkgs.lato}"
      export GI_TYPELIB_PATH="${kanataLayerIndicatorGiPath}"
      export LD_LIBRARY_PATH="${kanataLayerIndicatorLibPath}''${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
      exec python3 ${./kanata-layer-indicator.py} "$@"
    '';
  };

  cfg = config.kartoza.kanata;
in
{
  options.kartoza.kanata.aercLayer = lib.mkOption {
    type = lib.types.bool;
    default = false;
    example = true;
    description = ''
      Take over the herdr trigger key (Caps Lock) for aerc (a mail
      client) commands too, toggled with a caps+space chord — see
      docs/user/keyboard.md. Off by default: gisnix does not install
      aerc, so a mail-client macro layer has no business shipping to
      everyone. A host that runs aerc sets this from its own config,
      e.g. `kartoza.kanata.aercLayer = true;`.
    '';
  };

  options.kartoza.kanata.obsLayer = lib.mkOption {
    type = lib.types.bool;
    default = false;
    example = true;
    description = ''
      Take over the herdr trigger key (Caps Lock) for OBS scene-switch
      commands too, reached by cycling caps+space (herdr -> aerc, if
      also on -> obs -> herdr) — see docs/user/keyboard.md. Off by
      default, same reasoning as aercLayer: a scene-switch layer has no
      business shipping to everyone when OBS's branded scene collection
      (desktop-multimedia's obs-scenes module) is opt-in itself. A host
      that wants it sets `kartoza.kanata.obsLayer = true;`.
    '';
  };

  options.kartoza.kanata.layerIndicator = lib.mkOption {
    type = lib.types.bool;
    default = false;
    example = true;
    description = ''
      A tray icon showing which of herdr/aerc/obs the trigger key
      currently reaches — H, A or O — by following the same kanata TCP
      layer feed razer-layer-lights listens to (see
      kanata-layer-indicator.py). Needs the main "keyboard" instance's
      TCP port actually set (`services.kanata.keyboards.keyboard.port`)
      — off by default since most hosts don't opt into that port at
      all. A host that wants it sets
      `kartoza.kanata.layerIndicator = true;`.
    '';
  };

  # Everything below is config, not more options — once a module declares
  # a top-level `options`, NixOS requires the rest explicitly wrapped in
  # `config` rather than left alongside it (confirmed the hard way: "has
  # an unsupported attribute" on a real rebuild).
  config = {
    hardware.uinput.enable = true;

    # Passwordless sudo for the toggle/status scripts below.
    security.sudo.extraRules = [
      {
        groups = [ "wheel" ];
        commands = [
          {
            command = "/run/current-system/sw/bin/systemctl start kanata-*";
            options = [ "NOPASSWD" ];
          }
          {
            command = "/run/current-system/sw/bin/systemctl stop kanata-*";
            options = [ "NOPASSWD" ];
          }
          {
            command = "/run/current-system/sw/bin/systemctl restart kanata-*";
            options = [ "NOPASSWD" ];
          }
        ];
      }
    ];

    services.kanata = {
      enable = true;
      keyboards = {
        keyboard = {
          devices = [ ]; # match every keyboard

          # concurrent-tap-hold is required by defchordsv2 whenever a chord
          # file is in use; harmless when none is.
          #
          # danger-enable-cmd is UNCONDITIONAL here, and must stay that way:
          # this config ALWAYS emits at least one `cmd` action, because the
          # herdr macro-record toggle plays a sound (recordToggleSound +
          # beepPlayer, both passed unconditionally below) and kanata rejects a
          # config that uses `cmd` without it ("To use cmd you must put in
          # defcfg: danger-enable-cmd yes"), failing the BUILD — not eval.
          # This was previously gated on `emailScript != null || voxtypePtt`,
          # which broke every install the moment voxtypePtt went to false:
          # eval still passed, the kanata-config .kdb build did not. If you
          # ever make this conditional again, the gate must cover the sound
          # cmds (beepPlayer + recordToggleSound/beepSound), not just email and
          # voxtype — see tests/kanata-config-builds.nix, which guards this.
          extraDefCfg = ''
            process-unmapped-keys yes
            concurrent-tap-hold yes
            danger-enable-cmd yes
          '';

          config = import ./kanata-config.nix {
            inherit
              tapTimeout
              holdTimeout
              layout
              chordsFile
              emailScript
              ;
            # herdr ships in the `base` bundle, so its keybinds ship here too —
            # hold Caps Lock (a tap still toggles caps; nobody holds it on
            # purpose, so this costs nothing) for tab/workspace nav and the
            # agent list. aercLayer defaults off (see the option above) — gisnix
            # does not install aerc, so a mail-client macro layer has no
            # business shipping to everyone by default.
            herdrKey = "caps";
            aercLayer = cfg.aercLayer;
            obsLayer = cfg.obsLayer;
            # Only ever read when obsLayer is on (kanata-config.nix's own
            # gate), so harmless to always pass — same reasoning as
            # beepPlayer above.
            obsCli = "${pkgs.obs-cli}/bin/obs-cli";
            obsSceneStep = "${obsSceneStep}/bin/obs-scene-step";
            inherit obsScenePrefix;
            # Hold x/c/v for cut/copy/paste. A generic mechanism (no per-user
            # data involved, unlike emailScript above), so it ships on by
            # default along with everything else here.
            clipboardHolds = true;
            # Herdr<->aerc mode-toggle beep — only reached when aercLayer is
            # on, but harmless to always pass (kanata-config.nix's own
            # dualMode gate decides whether it's ever used).
            beepPlayer = "${kanataPlaySound}/bin/kanata-play-sound";
            beepSound = "${pkgs.sound-theme-freedesktop}/share/sounds/freedesktop/stereo/bell.oga";
            # herdr's macro-record toggle click — camera-shutter, not
            # bell.oga, so the two stay distinct.
            recordToggleSound = "${pkgs.sound-theme-freedesktop}/share/sounds/freedesktop/stereo/camera-shutter.oga";
          };
        };
      };
    };

    # Upstream's kanata module sets no `Restart=`, so systemd's default
    # (Restart=no) applies and a crash is terminal: the keyboard silently
    # reverts to its raw layout — no home-row mods, no nav layer — until
    # someone notices and restarts it by hand. A crash here is transient
    # (kanata check-builds every config it generates, so a unit that starts
    # at all has a valid one), so restarting is the right response. The
    # start limit is the backstop for a genuinely unstartable instance.
    systemd.services = lib.mapAttrs' (
      name: _:
      lib.nameValuePair "kanata-${name}" {
        startLimitIntervalSec = 60;
        startLimitBurst = 5;
        serviceConfig = {
          Restart = "on-failure";
          RestartSec = 3;
        };
      }
    ) config.services.kanata.keyboards;

    # Handy (https://github.com/cjpais/Handy) — local, offline speech-to-
    # text: press a shortcut, speak, press again, and it types the
    # transcription at your cursor. Whisper/Parakeet runs on-device;
    # nothing leaves the machine. Replaces voxtype, which this fleet found
    # too slow.
    #
    # Just a package here, deliberately — no systemd unit and no kanata
    # binding. Both were tried (see the commit that added, then the one
    # that removed, pkgs.kanata-handy-toggle) and dropped in favour of
    # Handy's own mechanisms: its tray Settings has its own global-
    # shortcut config and its own "launch at login" toggle, and leaning on
    # those means gisnix isn't re-implementing (and re-debugging) features
    # the app already ships. The cost is two one-time manual steps on a
    # fresh install — pick a model, and flip "launch at login" on — not
    # meaningfully different from the model pick already being manual.
    environment.systemPackages = with pkgs; [
      kanata
      handy

      (writeShellScriptBin "kanata-toggle" ''
        #!/usr/bin/env bash
        mapfile -t SERVICES < <(systemctl list-units --all --plain --no-legend 'kanata-*.service' | awk '{print $1}')
        [ ''${#SERVICES[@]} -eq 0 ] && { echo "No kanata services found"; exit 1; }

        if systemctl is-active --quiet "''${SERVICES[0]}"; then
          for s in "''${SERVICES[@]}"; do sudo systemctl stop "$s"; done
          notify-send -u normal -t 2000 "Kanata" "Keyboard remapping DISABLED" -i input-keyboard
          echo "Kanata disabled (''${SERVICES[*]})"
        else
          for s in "''${SERVICES[@]}"; do sudo systemctl start "$s"; done
          notify-send -u normal -t 2000 "Kanata" "Keyboard remapping ENABLED" -i input-keyboard
          echo "Kanata enabled (''${SERVICES[*]})"
        fi
      '')

      (writeShellScriptBin "kanata-status" ''
        #!/usr/bin/env bash
        systemctl list-units --all --plain --no-legend 'kanata-*.service' | awk '{print $1, $3}'
      '')

      (writeShellScriptBin "kanata-debug" ''
        #!/usr/bin/env bash
        echo "=== Kanata Keyboard Debugging ==="
        echo "1. Kanata service status:"
        systemctl status kanata-keyboard --no-pager

        echo -e "\n2. Available input devices:"
        ls -la /dev/input/by-path/ | grep -i kbd || echo "No keyboard devices found"

        echo -e "\n3. Kanata logs (last 20 lines):"
        journalctl -u kanata-keyboard --no-pager -n 20

        echo -e "\n4. uinput device:"
        ls -la /dev/uinput 2>/dev/null || echo "/dev/uinput not found"

        echo -e "\n5. Groups for current user:"
        groups
      '')

      (writeShellScriptBin "kanata-test" ''
        #!/usr/bin/env bash
        echo "Testing kanata with verbose output (Ctrl+C to exit)..."
        sudo kanata --cfg /etc/kanata/keyboard.kbd --debug
      '')
    ]
    ++ lib.optional cfg.layerIndicator kanataLayerIndicator;

    # H/A/O tray icon for the herdr/aerc/obs cycle — see
    # kanata-layer-indicator.py's own module docstring. Same
    # graphical-session wiring as razer-layer-lights (abyss's own
    # hosts/abyss/kanata-keyboard.nix), restarting on crash for the same
    # reason: a quiet tray icon is a worse failure mode than a brief gap
    # while it restarts.
    systemd.user.services.kanata-layer-indicator = lib.mkIf cfg.layerIndicator {
      description = "H/A/O tray icon for the kanata herdr/aerc/obs cycle";
      wantedBy = [ "graphical-session.target" ];
      partOf = [ "graphical-session.target" ];
      after = [ "graphical-session.target" ];
      serviceConfig = {
        ExecStart = "${kanataLayerIndicator}/bin/kanata-layer-indicator --listen 127.0.0.1:${toString config.services.kanata.keyboards.keyboard.port}";
        Restart = "on-failure";
        RestartSec = 3;
      };
    };
  };
}

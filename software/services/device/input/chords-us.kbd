;; Bracket chords for US-layout boards. CHORD LINES ONLY — no defchordsv2
;; wrapper. kanata-config.nix emits the single allowed defchordsv2 block;
;; this file supplies its contents when a host's `kanataLayout` is "us"
;; (the default). Pair with chords-pt.kbd for a pt-PT layout instead — see
;; kanata-keyboard.nix's layout-keyed lookup.
;;
;; A fast roll of the two keys still types them as normal letters; only a
;; true press-together within the window fires the chord.
;;
;; Bracket pairs (mirror design), US output keycodes:
;;   qw -> {    op -> }
;;   as -> [    lk -> ]
;;   xz -> <    m, -> >
;;
;; as and lk sit on home-row mod keys (a=Super s=Alt, l=Alt k=Ctrl). Plain
;; outputs only — a tap-hold as a chord action crashes kanata 1.12.0
;; (thread panicked at parser/src/keys/mod.rs:1237: Invalid KeyCode: 883 —
;; an unguarded OsCode::from(u16) inside kanata itself, not a config bug).
;; The brackets are what these chords are FOR, so the chords keep them;
;; a and s (l and k) are still home-row mods on their own — press them more
;; than 40 ms apart and both modifiers apply as normal, exactly as d+f
;; already stacks Ctrl+Shift.

  ;; --- bracket pairs (40 ms press-together window), US output ---
  (q w) S-[   40 all-released ()  ;; {  = Shift+[
  (o p) S-]   40 all-released ()  ;; }  = Shift+]
  (x z) S-,   40 all-released ()  ;; <  = Shift+,
  (m ,) S-.   40 all-released ()  ;; >  = Shift+.

  ;; --- brackets on mod keys (see the tap-hold crash note above) ---
  (a s) [     40 all-released ()  ;; [
  (l k) ]     40 all-released ()  ;; ]

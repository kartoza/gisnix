+// `provision-model` deliberately authenticates under its own AppId rather
+// than reusing APP_ID/SCOPES above: `session::with_token` caches one
+// token per AppId, so sharing APP_ID with ping/status/record (scoped
+// transcribe+status) would mean whichever call runs first wins the
+// cached token's scopes, and the other starts getting `403 scope_denied`
+// with no automatic re-auth (that only happens on `401`). A separate
+// AppId gets its own keyring cache entry. The *binary* is still
+// `super-stt-cli` either way, which is what the daemon's first-party
+// allowlist (`is_official_client`) actually checks — so this still
+// auto-approves without a consent popup.
+const PROVISION_APP_ID: AppId = AppId("super-stt-cli-provision");
+const PROVISION_APP_NAME: &str = "Super STT CLI (model provisioning)";
+const PROVISION_SCOPES: &[&str] = &["settings"];
+
+// This fleet's default local speech model, provisioned automatically so
+// dictation works the moment the daemon is up — no GUI app required (the
+// upstream app/-cosmic-applet/-consent builds are excluded entirely; see
+// package.nix's WORKSPACE SUBSET note). `super-stt-whisper` is `online:
+// false` in the published catalog (jorge-menjivar.github.io/super-stt/
+// index.json) — audio never leaves the machine, matching this fleet's
+// "nothing leaves the machine" stance for dictation (docs/user/keyboard.md).
+// `whisper-small.en` over a bigger/multilingual model: CPU-capable (no GPU
+// required, so it works on every host in the fleet) and a reasonable
+// speed/accuracy balance for English dictation. Stage 1 is the
+// transcription role (docs/protocol/endpoints/v1/pipeline.md).
+const PROVISION_STAGE: &str = "1";
+const PROVISION_BACKEND_SOURCE: &str = "github.com/jorge-menjivar/super-stt-whisper";
+const PROVISION_MODEL: &str = "whisper-small.en";
+
+// Hard bound on acquiring a session token (the daemon-side keyring read
+// at startup, and our own client-side keyring cache, both go through
+// the system secret-service over D-Bus — see the daemon's own log line
+// "if the keyring is locked, the daemon will wait here until it is
+// unlocked"). Found 2026-10-26: a stuck/unreachable secret-service
+// hangs this indefinitely with no error at all, since nothing in
+// `session::with_token` itself times out — the first real run burned a
+// full 30 minutes (systemd's own TimeoutStartSec) with zero output
+// before being killed. Failing fast here means a stuck keyring produces
+// a clear error and a quick systemd retry instead of a silent 30-minute
+// stall every single attempt.
+const TOKEN_ACQUIRE_TIMEOUT: Duration = Duration::from_secs(60);
+

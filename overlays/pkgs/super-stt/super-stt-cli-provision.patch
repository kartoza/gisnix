+/// Entry point for `provision-model`: authenticate under the dedicated
+/// provisioning AppId/scopes (see the const's doc comment) and run the
+/// idempotent install-select-load sequence. Token acquisition is bounded
+/// by `TOKEN_ACQUIRE_TIMEOUT` (see its doc comment for why) — the install
+/// and model-load steps below have their own, separate, longer polling
+/// timeouts for the genuinely slow network operations.
+async fn cmd_provision_model(socket_path: PathBuf) -> Result<()> {
+    let fut = run_with_token_as(
+        socket_path.clone(),
+        PROVISION_APP_ID,
+        PROVISION_APP_NAME,
+        PROVISION_SCOPES,
+        |t| provision_model_inner(socket_path.clone(), t),
+    );
+    match tokio::time::timeout(TOKEN_ACQUIRE_TIMEOUT, fut).await {
+        Ok(result) => result,
+        Err(_elapsed) => Err(anyhow!(
+            "timed out after {}s acquiring a session token — the system keyring/secret-service may be locked or unreachable",
+            TOKEN_ACQUIRE_TIMEOUT.as_secs()
+        )),
+    }
+}
+
+/// Ensure `PROVISION_MODEL` is installed, selected, and loaded on
+/// `PROVISION_STAGE`, doing nothing if it already is. Written as a
+/// straight-line sequence of daemon-visible steps (install -> select
+/// backend -> load model) rather than a single endpoint because the
+/// daemon's own API is shaped that way (see
+/// docs/protocol/endpoints/v1/pipeline/stage.md's "Only the backend"
+/// note and .../pipeline/model.md) — selecting a backend never loads a
+/// model, and installing a backend never selects it anywhere.
+async fn provision_model_inner(
+    socket_path: PathBuf,
+    token: String,
+) -> super_stt_shared::daemon::http_client::HttpResult<()> {
+    use http_client::transport::{get_json, post_json};
+
+    let model_path = format!("/pipeline/{PROVISION_STAGE}/model");
+
+    let current: Value = get_json(socket_path.clone(), &token, &model_path).await?;
+    if is_our_model_loaded(&current) {
+        println!("{PROVISION_MODEL} is already loaded on stage {PROVISION_STAGE}.");
+        return Ok(());
+    }
+
+    println!("Installing backend {PROVISION_BACKEND_SOURCE}...");
+    let install_body = json!({ "source": PROVISION_BACKEND_SOURCE });
+    match post_json::<Value>(
+        socket_path.clone(),
+        &token,
+        "/registry/backend/install",
+        &install_body,
+    )
+    .await
+    {
+        Ok(_) => {}
+        // "source is the identity this is judged on, so re-installing...
+        // the same backend is unaffected" (install.md) — but a second
+        // *concurrent* install for the same source is refused outright
+        // (409 install_in_progress) rather than treated as a duplicate
+        // no-op. Fine either way: just wait for whichever install (ours
+        // or the one already running) to finish below.
+        Err(http_client::HttpError::Other(msg)) if msg.contains("install_in_progress") => {}
+        Err(e) => return Err(e),
+    }
+
+    wait_for_backend_installed(socket_path.clone(), &token).await?;
+
+    println!("Selecting backend for stage {PROVISION_STAGE}...");
+    let select_body = json!({ "source": PROVISION_BACKEND_SOURCE });
+    post_json::<Value>(
+        socket_path.clone(),
+        &token,
+        &format!("/pipeline/{PROVISION_STAGE}"),
+        &select_body,
+    )
+    .await?;
+
+    println!("Loading model {PROVISION_MODEL} (this downloads the model's weights the first time; may take a while)...");
+    let load_body = json!({ "model": PROVISION_MODEL });
+    post_json::<Value>(socket_path.clone(), &token, &model_path, &load_body).await?;
+
+    wait_for_model_loaded(socket_path, &token, &model_path).await?;
+
+    println!("Provisioned {PROVISION_MODEL} on stage {PROVISION_STAGE}.");
+    Ok(())
+}
+
+/// `true` if the `GET /pipeline/{stage}/model` response `resp` already
+/// has `PROVISION_MODEL` selected and running. Nested under `.model`
+/// per docs/protocol/endpoints/v1/pipeline/model.md's response shape —
+/// `{"status":"success","model":{"stage":1,"model":"...","loaded":bool,...}}`.
+fn is_our_model_loaded(resp: &Value) -> bool {
+    resp["model"]["model"].as_str() == Some(PROVISION_MODEL)
+        && resp["model"]["loaded"].as_bool() == Some(true)
+}
+
+/// Poll `GET /backend/list` (installed backends) until
+/// `PROVISION_BACKEND_SOURCE` shows up. The install endpoint itself only
+/// confirms the request was accepted (`202`, see install.md) — the
+/// actual install runs in the background, with no synchronous "done"
+/// signal other than this list gaining the entry. Polling rather than
+/// subscribing to `/events` since this only needs a single boolean, not
+/// live progress, and keeps this a plain request/response client.
+async fn wait_for_backend_installed(
+    socket_path: PathBuf,
+    token: &str,
+) -> super_stt_shared::daemon::http_client::HttpResult<()> {
+    use http_client::transport::get_json;
+    const TIMEOUT: Duration = Duration::from_secs(600);
+    const POLL_EVERY: Duration = Duration::from_secs(3);
+    let deadline = tokio::time::Instant::now() + TIMEOUT;
+    loop {
+        let backends: Value = get_json(socket_path.clone(), token, "/backend/list").await?;
+        let installed = backends["backends"]
+            .as_array()
+            .is_some_and(|list| list.iter().any(|b| b["source"].as_str() == Some(PROVISION_BACKEND_SOURCE)));
+        if installed {
+            return Ok(());
+        }
+        if tokio::time::Instant::now() >= deadline {
+            return Err(http_client::HttpError::Other(format!(
+                "timed out after {}s waiting for backend {PROVISION_BACKEND_SOURCE} to finish installing",
+                TIMEOUT.as_secs()
+            )));
+        }
+        tokio::time::sleep(POLL_EVERY).await;
+    }
+}
+
+/// Poll `GET /pipeline/{stage}/model` until `PROVISION_MODEL` reports
+/// `loaded: true`. Stage 1 answers the load request itself with `202
+/// Accepted` and switches asynchronously (model.md) — same shape as the
+/// backend install above. `switch.phase` turning `"error"` (the `switch`
+/// object's documented vocabulary, pipeline.md's "The switch object")
+/// means the load failed; the object carries no error-message field, so
+/// this can only report that it happened, not why — check the daemon's
+/// own logs/the `/events` stream for detail.
+async fn wait_for_model_loaded(
+    socket_path: PathBuf,
+    token: &str,
+    model_path: &str,
+) -> super_stt_shared::daemon::http_client::HttpResult<()> {
+    use http_client::transport::get_json;
+    const TIMEOUT: Duration = Duration::from_secs(600);
+    const POLL_EVERY: Duration = Duration::from_secs(3);
+    let deadline = tokio::time::Instant::now() + TIMEOUT;
+    loop {
+        let current: Value = get_json(socket_path.clone(), token, model_path).await?;
+        if is_our_model_loaded(&current) {
+            return Ok(());
+        }
+        if current["model"]["switch"]["phase"].as_str() == Some("error") {
+            return Err(http_client::HttpError::Other(
+                "model load failed (switch phase = error; check the daemon's logs/the /events stream for why)"
+                    .to_string(),
+            ));
+        }
+        if tokio::time::Instant::now() >= deadline {
+            return Err(http_client::HttpError::Other(format!(
+                "timed out after {}s waiting for {PROVISION_MODEL} to finish loading",
+                TIMEOUT.as_secs()
+            )));
+        }
+        tokio::time::sleep(POLL_EVERY).await;
+    }
+}

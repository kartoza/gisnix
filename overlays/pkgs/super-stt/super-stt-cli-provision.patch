+/// Like [`run_with_token`] but with an explicit app identity/scope set,
+/// so a command that needs different scopes (`provision-model`, which
+/// needs `settings`) doesn't collide with the cached token the other
+/// commands share under `APP_ID`.
+async fn run_with_token_as<F, Fut, T>(
+    socket_path: PathBuf,
+    app_id: AppId,
+    app_name: &str,
+    scopes: &[&str],
+    op: F,
+) -> Result<T>
+where
+    F: Fn(String) -> Fut,
+    Fut: std::future::Future<Output = super_stt_shared::daemon::http_client::HttpResult<T>>,
+{
+    session::with_token(socket_path, app_id, app_name, scopes, op)
         .await
         .map_err(|e| anyhow!(e))
 }

@startuml install-journey
!include _theme.puml

title Installing gisnix — from USB stick to a running machine

start
:Write the ISO to a USB stick;
:Boot the target machine\nfrom the stick (UEFI);
:Connect to the network\n**sudo nmtui**;
:Start the installer\n**sudo setup**;

partition "The setup wizard asks you" {
  :Your name and account;
  :A hostname;
  :A locale\n(keyboard · timezone · language);
  :A storage layout;
}

if (Storage layout?) then (ZFS, encrypted)
  :Choose a disk-encryption\npassphrase;
else (plain XFS / multi-disk ZFS)
endif

:Confirm — type the hostname back\n//This is the point of no return://\nthe target disk is erased;

partition "The installer does the rest" {
  :Partition and format the disk\n(disko);
  :Build the system\nand copy it onto the disk;
  :Install NixOS and the\nGRUB boot loader;
  :Copy the machine's flake into\n**~/nixos-config**;
}

:Reboot and remove the stick;
:A minimal working machine:\nencrypted ZFS + COSMIC desktop;

stop
@enduml
